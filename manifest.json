{
  "manifest_version": 3,
  "name": "SetterScraper",
  "version": "1.0.0",
  "description": "Sync your Nuvohub clients to Google Sheets automatically. No setup required.",
  "key": "",
  "permissions": ["identity", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://nuvohub.ca/*",
    "https://firestore.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "oauth2": {
    "client_id": "1054789399000-8dq52k9rve5tdte3qjsiasiv34jo0j7o.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },

  "icons": {}
}
